# 배포할 때만 채우면 된다. 로컬 개발 중에는 비워두는 게 정상이며,
# 비어 있으면 /api 요청이 vite.config.ts 의 프록시를 타서 CORS 문제가 발생하지 않는다.
VITE_API_BASE_URL=

# 개발 서버 프록시가 요청을 전달할 백엔드 주소 (기본값과 같으면 지정할 필요 없음)
VITE_DEV_PROXY_TARGET=https://api.handover-card.o-r.kr

# POST /api/handover-cards 의 multipart 오디오 파트 이름.
# 실제 서버에 확인한 결과 "audio" 이며, 이 값이 코드의 기본값이므로 비워둬도 된다.
# 백엔드가 파라미터명을 바꿨을 때만 여기에 지정한다.
VITE_AUDIO_FIELD_NAME=
